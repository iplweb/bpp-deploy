# ============================================================================
# WLASNE NADPISANIA MODSECURITY (BPP)
# ============================================================================
#
# Plik jest renderowany przez 20-envsubst-on-templates.sh z
# /etc/nginx/templates/modsecurity.d/modsecurity-override.conf.template
# do /etc/modsecurity.d/modsecurity-override.conf, a setup.conf includuje go
# PRZED regulami CRS:
#
#     Include /etc/modsecurity.d/modsecurity.conf
#     Include /etc/modsecurity.d/modsecurity-override.conf   <-- tutaj
#     Include /etc/modsecurity.d/owasp-crs/crs-setup.conf
#     Include /etc/modsecurity.d/owasp-crs/rules/*.conf
#
# Kolejnosc ma znaczenie: `SecRuleRemoveById` NIE zadziala tutaj, bo reguly
# CRS jeszcze nie istnieja w momencie parsowania. Dziala natomiast akcja `ctl`
# w NASZEJ regule, bo jest wykonywana w trakcie transakcji.
#
# Zakres ID: 1-99999 jest zarezerwowany dla regul lokalnych. CRS uzywa
# 900000-999999, wiec nie ma ryzyka kolizji.

# ---------------------------------------------------------------------------
# 10001: healthcheck Dockera nie trafia do audit logu
# ---------------------------------------------------------------------------
# Healthcheck (docker-compose.infrastructure.yml) wola
# `curl http://127.0.0.1:80/healthz` co 10 sekund. Numeryczny adres w
# naglowku Host zapala regule CRS 920350 ("Host header is a numeric IP
# address") — co daje ~8640 wpisow audytowych na dobe i topi realne trafienia,
# po ktore w ogole zbieramy baseline.
#
# Wylaczamy audit log dla TEJ transakcji zamiast wylaczac regule globalnie:
# 920350 na ruchu z zewnatrz jest sensowna (skanery wola po IP, nie po nazwie)
# i chcemy ja zachowac.
#
# Uwaga: to wycisza wylacznie LOGOWANIE. Regula nadal dolicza swoj wklad do
# anomaly score, ale zmierzone: /healthz nie przekracza progu (949110 sie nie
# zapala), wiec po przelaczeniu na SecRuleEngine=On healthcheck nie zacznie
# padac.
SecRule REQUEST_URI "@streq /healthz" \
    "id:10001,\
    phase:1,\
    pass,\
    nolog,\
    ctl:auditEngine=Off"

# ---------------------------------------------------------------------------
# 10002, 10003: sciezki, na ktorych WAF tylko obserwuje, nigdy nie blokuje
# ---------------------------------------------------------------------------
# Blokowanie jest wlaczone globalnie (MODSEC_RULE_ENGINE=On), ale dwa miejsca
# w BPP z GORY wiadomo, ze beda dawac falszywe alarmy — a przy odpowiedzi 444
# objaw jest wyjatkowo mylacy: uzytkownik widzi zerwane polaczenie, bez zadnego
# komunikatu, wiec nie ma jak sie domyslic, ze zatrzymal go WAF.
#
# Dlatego dla tych dwoch sciezek schodzimy do DetectionOnly: trafienia nadal
# ida do audit logu (i posluza do napisania precyzyjnych wykluczen), ale nikomu
# nie urywaja polaczenia.
#
# Zdejmowac po zebraniu baseline, zastepujac celowanymi wykluczeniami regul.

# dbtemplates: superuser edytuje szablony HTML w panelu admina, czyli POST-uje
# surowy HTML z JavaScriptem. To kanoniczny falszywy alarm rodziny 941 (XSS),
# opisany wprost w dokumentacji CRS.
SecRule REQUEST_URI "@beginsWith /admin/dbtemplates/" \
    "id:10002,\
    phase:1,\
    pass,\
    nolog,\
    ctl:ruleEngine=DetectionOnly"

# DjangoQL: uzytkownik wpisuje tam dowolny tekst zapytania, wiec zapalic sie
# moze praktycznie kazda rodzina regul — nie tylko 942 (SQL). Potwierdzone na
# stagingu 2026-08-03: `query=test = 5/etc/passwd` zapalilo 930120 (LFI),
# 932235 i 932160 (RCE), laczny score 15 przy progu 5 -> blokada.
#
# UWAGA — SA DWA ENDPOINTY i latwo wykluczyc tylko jeden:
#   /bpp/zapytanie/     — interfejs uzytkownika (bpp/src/bpp/urls.py:113),
#   /api/v1/zapytanie/  — wariant API.
# Ten pierwszy jest wazniejszy: to w nim ludzie realnie pisza zapytania.
SecRule REQUEST_URI "@rx ^/(bpp|api/v1)/zapytanie/" \
    "id:10003,\
    phase:1,\
    pass,\
    nolog,\
    ctl:ruleEngine=DetectionOnly"

# ---------------------------------------------------------------------------
# 10004: panele administracyjne bez inspekcji CIALA ODPOWIEDZI
# ---------------------------------------------------------------------------
# Reguly wychodzace (RESPONSE-95x) skanuja cialo odpowiedzi w poszukiwaniu
# WYCIEKOW z aplikacji: komunikatow bledow PHP/SQL/Javy, listingow katalogow,
# web shelli. Za /grafana/, /dozzle/, /flower/ i /netdata/ nie stoi zadna
# aplikacja BPP — stoi tam gotowy dashboard innego producenta, dostepny
# WYLACZNIE dla superusera (auth_request /_bpp_superuser_auth). Skanowanie
# jego HTML-a nie chroni przed niczym, za to generuje falszywe alarmy.
#
# POTWIERDZONY PRZYPADEK (staging, 2026-08-03): wejscie na /grafana/ konczylo
# sie urwana strona. Grafana wstrzykuje w index.html obiekt
# `window.grafanaBootData`, a w nim klucz "sqlConnectionLimits". Reguła 953100
# uzywa `@pmFromFile php-errors.data`, czyli dopasowania po PODCIAGU, bez
# granic slowa i bez wielkosci liter — a w tym pliku danych byl WOWCZAS wpis
# `SQLConnect` (funkcja ODBC z PHP). "sqlConnect" siedzi w srodku
# "sqlConnectionLimits", wiec regula zapalala sie na KAZDEJ stronie Grafany.
# Severity ERROR = +4 do outbound_anomaly_score przy progu 4 (ANOMALY_OUTBOUND),
# wiec JEDNO takie trafienie od razu przekracza prog.
#
# TEN CIAG JUZ NIE ZAPALA REGULY — I TO JEST ARGUMENT ZA WYKLUCZENIEM, NIE
# PRZECIW. Zmierzone ponownie 2026-08-12 na aktualnym obrazie: cialo
# z `window.grafanaBootData` i "sqlConnectionLimits" przechodzi BEZ trafien,
# bo wpisu `SQLConnect` nie ma juz w php-errors.data (dzis 218 wpisow, same
# dlugie frazy). Sama regula dziala — kontrolne cialo z "Cannot redeclare
# class" / "Stack trace:" nadal daje 953100 + 959100.
#
# Zmienily sie DANE UPSTREAMU, nie nasza konfiguracja: owasp/modsecurity-crs
# :nginx to tag PLYWAJACY i wraz z przebudowa obrazu przyjezdzaja nowe pliki
# *.data (ten sam mechanizm ugryzl nas przy 920430, 2026-08-05). Dlatego
# uzasadnieniem 10004 NIE jest jeden zaobserwowany ciag, tylko to, ze za
# panelami stoi cudzy dashboard, ktorego HTML-a nie ma sensu skanowac — a jego
# kolejna wersja, tak jak kolejna wersja pliku danych CRS, moze przyniesc nowy
# falszywy alarm. NIE ZAWEZAJ tego wykluczenia do konkretnego wzorca.
#
# DLACZEGO OBJAW JEST MYLACY: 959100 dziala w phase:4, czyli gdy nginx WYSLAL
# JUZ NAGLOWKI odpowiedzi. Nie da sie wtedy zwrocic 403 (a wiec i naszego 444)
# — nginx zapisuje `[alert] header already sent`, urywa strumien, a w access
# logu zostaje `500 0`. Uzytkownik widzi pusta/uciecia strone, nie blokade.
#
# ZAKRES: zdejmujemy CALY zakres regul wychodzacych 950000-959999 (rodziny
# RESPONSE-950..956 + ewaluacja progu 959100), a NIE caly `ruleEngine` jak
# w 10002/10003. Zadania PRZYCHODZACE do paneli — URI, naglowki, cialo POST-a,
# rodziny 913/920/930/932/941/942 i blokada 949110 — sa nadal w pelni
# egzekwowane. Znika wylacznie skanowanie tego, co panel odsyla.
#
# UWAGA NA SKLADNIE: `ctl:responseBodyAccess=Off` bylaby czytelniejsza, ale
# libmodsecurity v3 JEJ NIE ZNA — nginx nie wstaje z bledem "Expecting an
# action, got: ctl:responseBodyAccess". Sprawdzone na owasp/modsecurity-crs:nginx
# (ModSecurity v3.0.16): z akcji `ctl` dzialaja m.in. ruleEngine, auditEngine,
# ruleRemoveById (takze z zakresem A-B) i ruleRemoveByTag.
#
# Zmierzone: z paneli tylko Grafana zapala reguly wychodzace; Dozzle, Flower
# i Netdata (lacznie ze 100 KB dashboardem) przechodza czysto. Wykluczenie
# obejmuje mimo to wszystkie cztery — sa tej samej natury (obcy dashboard za
# auth), a kolejna ich wersja moze wprowadzic wlasny falszywy alarm.
SecRule REQUEST_URI "@rx ^/(grafana|dozzle|flower|netdata)(/|$)" \
    "id:10004,\
    phase:1,\
    pass,\
    nolog,\
    ctl:ruleRemoveById=950000-959999"

# ---------------------------------------------------------------------------
# 10005: 920280 ("Request Missing a Host Header") nie ma sensu pod HTTP/2 i /3
# ---------------------------------------------------------------------------
# W HTTP/1.1 adres serwera jedzie w prawdziwym naglowku `Host:`. W HTTP/2 i
# HTTP/3 zastapil go PSEUDO-NAGLOWEK `:authority`, ktorego konektor
# ModSecurity-nginx (v1.0.4) nie widzi — on iteruje po liscie naglowkow
# nginksa, a `:authority` tam nie trafia.
#
# Efekt: 920280 (`&REQUEST_HEADERS:Host "@eq 0"`, severity CRITICAL = 5 pkt)
# zapala sie na KAZDYM zadaniu HTTP/3, samo z siebie osiaga prog anomalii (5)
# i 949110 blokuje wszystko. Nie tylko ataki — zwykle `GET /`.
#
# Zmierzone 2026-08-03 na publikacje-test.up.lublin.pl i odtworzone lokalnie na
# tym samym obrazie i tej samej konfiguracji, klientem curl z HTTP/3: audit log
# pokazuje `"http_version":"3.0"` i liste naglowkow BEZ `host`, mimo ze klient
# wyslal `Host:` — dowod, ze gubi go konektor, a nie klient.
#
# UWAGA: `make test-waf` tej klasy bledu NIE ZLAPIE — cala bateria strzela
# `curl --http1.1`, czyli protokolem, w ktorym `Host:` istnieje. Zeby dolozyc
# tam przypadek h3, trzeba opublikowac takze 443/udp i miec klienta z QUIC.
#
# To NIE jest teoretyczne: vhost reklamuje `Alt-Svc: h3=":443"; ma=86400`
# (vhost.conf.template), wiec przegladarka raz przelaczona na h3 trzyma sie go
# przez dobe. Po wlaczeniu blokowania oznaczalo to pelna niedostepnosc serwisu
# dla Safari/Firefox/Chrome — i to bez komunikatu, bo pod QUIC nasze 444 nie
# zrywa polaczenia czysto, tylko zostawia klienta wiszacego do timeoutu.
#
# Ten sam blad ugryzl juz `_bpp-locations.conf` (pusty `$http_host` pod h3
# psul redirect logowania) — patrz komentarz przy `location @bpp_login`.
#
# Wylaczamy regule TYLKO dla h2/h3, bo dla HTTP/1.0 i /1.1 nadal niesie
# wartosc. Nic przy tym nie tracimy: nginx sam odrzuca zadanie 2/3 bez
# `:authority` (i 1.1 bez `Host:`) bledem 400, zanim dojdzie do aplikacji.
#
# Regexp znosi obie mozliwe postacie zmiennej ("HTTP/3.0" oraz "3.0"), bo
# konektor nie gwarantuje ktora zobaczymy. `ctl:ruleRemoveById` dziala, bo
# 10005 i 920280 sa oba w phase:1, a nasz plik jest includowany PRZED CRS.
SecRule REQUEST_PROTOCOL "@rx ^(HTTP/)?[23]\." \
    "id:10005,\
    phase:1,\
    pass,\
    nolog,\
    ctl:ruleRemoveById=920280"

# ---------------------------------------------------------------------------
# 10006: /grafana/ CALKOWICIE poza inspekcja WAF-a
# ---------------------------------------------------------------------------
# Grafana jest jedynym miejscem w BPP, w ktorym WAF nie ma czego chronic, za to
# ma gwarantowane falszywe alarmy. Powod jest strukturalny, nie kosmetyczny:
# ciala zadan do /grafana/api/ds/query to ZAPYTANIA LogQL, a wiec z natury
# tekst pelen metaznakow powloki i regexpow — i, w przypadku dashboardu WAF-a,
# doslownie PAYLOADY ATAKOW, po ktorych operator filtruje. Skanowanie tego
# regulami CRS oznacza podawanie WAF-owi jego wlasnych znalezisk na wejscie.
# Wykluczenie punktowe tej klasy nie domknie: kazde kolejne pole dashboardu
# dokłada nowy zestaw regul do wyłączenia.
#
# POTWIERDZONY PRZYPADEK (produkcja publikacje-test.up.lublin.pl, 2026-08-05):
# KAZDY POST na /grafana/api/ds/query konczyl sie 403, a wiec KAZDY panel
# kazdego dashboardu pokazywal "No data". Wyzwalaczem bylo rozwiniecie zmiennej
# `$level` przy "Log Level = All":
#
#     detected_level=~"critical|debug|error|info|unknown|warn"
#
# W srodku siedzi `|debug`. Regula 932110 (REQUEST-932, "Remote Command
# Execution: Windows Command Injection") szuka wzorca "metaznak powloki, potem
# nazwa polecenia" — a `debug` to polecenie DOS-a z jej slownika. Audit log
# wprost: `Matched Data: |debug found within ARGS:json.queries.array_0.expr`.
# Severity CRITICAL = 5 pkt przy progu ANOMALY_INBOUND 5, wiec JEDNO trafienie
# od razu blokuje. Objaw jest maksymalnie mylacy: dashboard laduje sie
# normalnie (GET-y przechodza), puste sa dopiero dane.
#
# DLACZEGO WOLNO NAM TO WYLACZYC: caly `location /grafana/`
# (_bpp-locations.conf) stoi za `auth_request /_bpp_superuser_auth`. Zadanie
# anonimowe dostaje 401 i redirect na logowanie BPP, zanim dojdzie do Grafany.
# Wylaczamy wiec inspekcje ruchu, ktory i tak moze wygenerowac wylacznie
# zalogowany SUPERUSER — czyli ktos, kto ma w BPP uprawnienia daleko
# powazniejsze niz cokolwiek, co CRS moglby tu powstrzymac.
#
# ZAKRES: `ctl:ruleEngine=Off`, czyli twardo caly silnik dla tej transakcji —
# nie DetectionOnly jak w 10002/10003 (bo trafienia nie sa nam do niczego
# potrzebne i tylko zasmiecaja dashboard WAF-a) i nie zakres regul jak
# w 10004 (bo problem nie ogranicza sie do jednej rodziny: LogQL potrafi
# zapalic 930/932/941/942 naraz — patrz komentarz przy 10003, gdzie ten sam
# mechanizm zmierzono dla DjangoQL: score 15 przy progu 5).
#
# REGULA 10004 ZOSTAJE NIETKNIETA i nadal wymienia /grafana/. Jest teraz dla
# niej nadmiarowa, ale jest to nadmiarowosc celowa: gdyby ktos kiedys zwezil
# 10006 (np. tylko do /grafana/api/), reszta Grafany zostalaby bez zadnej
# oslony przed regulami WYCHODZACYMI. Nie chodzi przy tym o jeden znany ciag —
# `sqlConnectionLimits` akurat PRZESTAL zapalac 953100 po zmianie pliku danych
# upstreamu (patrz komentarz przy 10004) — tylko o to, ze cudzy dashboard moze
# przyniesc KOLEJNY falszywy alarm, ktorego dzis nie znamy.
#
# NIE ROZSZERZAC "przy okazji" na /dozzle/, /flower/ i /netdata/ bez pomiaru.
# Dozzle jest kandydatem z tego samego powodu (przegladarka logow przesyla
# szukany tekst), ale nikt tego nie zmierzyl, a spekulatywne poszerzanie
# wykluczen to dokladnie ten nawyk, ktory ta konfiguracja stara sie trzymac
# w ryzach.
SecRule REQUEST_URI "@rx ^/grafana(/|$)" \
    "id:10006,\
    phase:1,\
    pass,\
    nolog,\
    ctl:ruleEngine=Off"

# ---------------------------------------------------------------------------
# 10007: OAuth (/o/ i /.well-known/) — 931100 blokuje petle zwrotna,
#        czyli calego klienta natywnego
# ---------------------------------------------------------------------------
# Regula 931100 ("Possible RFI Attack: URL Parameter using IP Address") szuka
# w argumentach URL-a z LITERALEM ADRESU IP zamiast nazwy hosta. Klasyczny
# atak RFI wyglada wlasnie tak: `?page=http://198.51.100.7/shell.txt`.
#
# Kloci sie to wprost z RFC 8252 (OAuth dla aplikacji natywnych), ktore dla
# klienta bez wlasnej domeny — CLI, skrypt, serwer MCP — przewiduje odbior
# kodu na petli zwrotnej, i to WLASNIE po literale IP. Sekcja 7.3: "Specifying
# a redirect URI with the loopback IP literal rather than localhost avoids
# inadvertently listening on network interfaces other than the loopback
# interface", a wariant z nazwa jest tam oznaczony jako NOT RECOMMENDED.
#
# Efekt jest wiec odwrotny do zamierzonego: CRS przepuszcza forme ODRADZANA
# przez standard, a blokuje ZALECANA.
#
# ZMIERZONE (2026-08-07, ten sam obraz, BLOCKING_PARANOIA=1):
#
#   redirect_uri=http://127.0.0.1:50603/callback   -> 403   (931100)
#   redirect_uri=http://[::1]:50603/callback       -> przelot
#   redirect_uri=http://localhost:50603/callback   -> przelot
#
# 931100 ma severity CRITICAL = 5 pkt przy ANOMALY_INBOUND 5, wiec jedno
# trafienie od razu przekracza prog — audit log pokazuje `Total Score: 5`
# i 949110. Nie ma tu zadnej kumulacji do wysycenia; wystarcza ta jedna regula.
#
# BLOKOWANY BYL CALY PRZEPLYW, NIE JEDEN ENDPOINT — i to jest powod, dla
# ktorego wykluczenie celuje w sciezke, a nie w nazwe argumentu:
#
#   POST /o/register/  (DCR, JSON)          -> 403
#   GET  /o/authorize/                      -> 403
#   POST /o/token/     (wymiana kodu)       -> 403
#   POST /o/token/     (refresh_token)      -> przelot (nie niesie redirect_uri)
#
# DLACZEGO NIE `ctl:ruleRemoveTargetById=931100;ARGS:redirect_uri`: sprawdzone,
# skladnia jest poprawna (nginx wstaje) i zalatwia `/o/authorize/` oraz
# `/o/token/`, ale NIE rejestracje klienta. DCR wysyla JSON, wiec ModSecurity
# nazywa argument `ARGS:json.redirect_uris.array_0` (dokladnie tak brzmi wpis
# `found within` w audit logu) — nazwa zalezy od formatu ciala i od INDEKSU
# W TABLICY. Wykluczenie po nazwie trzeba by wiec wyliczac dla kazdej formy
# osobno i tak juz rozsypuje sie przy kliencie z dwoma redirect_uri.
#
# ZAKRES: zdejmujemy JEDNA regule, na dwoch prefiksach tej samej powierzchni
# OAuth. Nie `ruleEngine=Off` jak w 10006 i nie zakres rodzin jak w 10004 —
# problem jest punktowy i tak ma zostac. Na `/o/` i `/.well-known/` nadal
# w pelni obowiazuja 941 (XSS), 942 (SQLi), 930 (LFI), 932 (RCE) i blokada
# progowa 949110.
#
# DLACZEGO TAKZE `/.well-known/`: to druga polowa tej samej powierzchni. Klient
# OAuth/MCP nie zna z gory adresow endpointow — najpierw pyta o metadane
# serwera autoryzacji (RFC 8414 `/.well-known/oauth-authorization-server`,
# RFC 9728 `/.well-known/oauth-protected-resource`), a dopiero z nich bierze
# `authorization_endpoint` i `token_endpoint`. Oba prefiksy sa uzywane
# WYMIENNIE w jednym logowaniu i musza byc traktowane tak samo — rozjechanie
# ich to gwarantowany blad przy nastepnej zmianie.
#
# Zmierzone 2026-08-07: samo discovery jest GET-em bez argumentow, wiec dzis
# 931100 sie tam nie zapala. Wykluczenie jest wiec zabezpieczeniem na wypadek,
# gdy klient dolozy argument z adresem petli zwrotnej (np. `resource=` z RFC
# 9728) — wtedy padloby DOKLADNIE tak samo jak `/o/`, tyle ze o krok wczesniej
# i bez zadnego sladu w Django, bo blokada konczy sie na brzegu.
#
# DLACZEGO TO BEZPIECZNE: RFI polega na tym, ze SERWER pobiera zasob spod
# adresu podanego przez atakujacego. django-oauth-toolkit nigdy nie odpytuje
# `redirect_uri` — porownuje go ze zbiorem URI zarejestrowanych dla klienta
# i najwyzej odsyla 302. Adres 127.0.0.1 wskazuje przy tym maszyne KLIENTA,
# nie nasza. Reguly 931100 na `/o/` nie ma czego chronic.
#
# NIE ROZSZERZAC na cala witryne. `?q=http://127.0.0.1/...` poza tymi dwoma
# prefiksami ma nadal dostawac 403 i pilnuja tego osobne asercje kontrolne
# w test-waf.sh — wykluczenie, ktore niczego nie wylacza, jest gorsze niz
# zadne, bo test przechodzi tak samo po skasowaniu reguly.
#
# UWAGA NA `.` W REGEXPIE: kropka w `\.well-known` MUSI byc escapowana. Bez
# tego wzorzec `^/(o|.well-known)/` lapie takze `/Xwell-known/` — i, co
# grozniejsze, kazdy prefiks jednoznakowy, bo `.` to dowolny znak.
SecRule REQUEST_URI "@rx ^/(o|\.well-known)/" \
    "id:10007,\
    phase:1,\
    pass,\
    nolog,\
    ctl:ruleRemoveById=931100"

# ---------------------------------------------------------------------------
# 10008: `accept-charset` znika z listy naglowkow zakazanych (920450)
# ---------------------------------------------------------------------------
# Regula 920450 ("HTTP header is restricted by policy") nie patrzy ani na URL,
# ani na argumenty — porownuje NAZWY NAGLOWKOW z lista `tx.restricted_headers`.
# Domyslnie sa na niej: accept-charset, content-encoding, proxy, lock-token,
# content-range, if. Paranoia 1, severity CRITICAL = 5 pkt przy progu 5, wiec
# sam naglowek, bez zadnej innej przewiny, wystarcza do blokady.
#
# ZGLOSZENIE 2026-08-07: uzytkownik dostal blokade na `/bpp/rekord/`, czyli na
# poprawnym adresie istniejacego rekordu. Objaw jest maksymalnie mylacy, bo
# dashboard WAF-a pokazuje URI zadania — a URI nie mial z blokada nic wspolnego.
# Przy diagnozie takich zgloszen: 920450 to JEDYNA regula, ktora blokuje bez
# zadnego zwiazku z trescia zadania.
#
# DLACZEGO `accept-charset` w ogole tam jest: naglowek zostal wycofany ze
# standardu (przegladarki go nie wysylaja), wiec CRS traktuje jego obecnosc
# jako sygnal klienta automatycznego. To heurystyka fingerprintingu, nie
# wykrycie ataku — nie da sie nim niczego zaatakowac.
#
# DLACZEGO NIE `ctl:ruleRemoveById=920450`: na tej samej liscie jest naglowek
# `Proxy`, czyli ochrona przed httpoxy (CVE-2016-5385) — aplikacja czytajaca
# `HTTP_PROXY` ze srodowiska dawala sie przekierowac przez naglowek zadania.
# Skasowanie calej reguly zdjeloby takze ja, a takze `content-encoding`,
# `lock-token`, `content-range` i `if`. Zamiast tego PRZEDEFINIOWUJEMY liste,
# usuwajac z niej jedna pozycje.
#
# DLACZEGO TO DZIALA Z TEGO PLIKU: CRS ustawia domyslna liste w
# REQUEST-901-INITIALIZATION.conf pod warunkiem, ze zmienna jeszcze nie
# istnieje. Nasz plik jest includowany PRZED regulami CRS, wiec w phase:1
# ustawiamy ja pierwsi i inicjalizacja CRS jej nie nadpisuje. Zakomentowany
# szablon tej samej operacji siedzi w crs-setup.conf jako regula 900250 —
# nie korzystamy z niego, bo crs-setup.conf nie jest naszym plikiem
# i `git pull` by go nie zaktualizowal.
#
# Zweryfikowane w `make test-waf` DWOMA przypadkami naraz: `Accept-Charset`
# przechodzi, a `Proxy` nadal jest blokowany. Sam pierwszy przypadek nie
# wystarcza — przeszedlby tak samo po skasowaniu calej reguly 920450, czyli
# nie odroznilby precyzyjnego wykluczenia od wylania dziecka z kapiela.
SecAction \
    "id:10008,\
    phase:1,\
    nolog,\
    pass,\
    t:none,\
    setvar:'tx.restricted_headers=/content-encoding/ /proxy/ /lock-token/ /content-range/ /if/'"

# ---------------------------------------------------------------------------
# 10009: formularze admina — CRS czyta tekst naukowy jako atak
# ---------------------------------------------------------------------------
# Sciezka `^/admin/<app>/<model>/` schodzi w CALOSCI do DetectionOnly. To jest
# ESKALACJA wykluczenia z 2026-08-12, ktore zdejmowalo tam JEDNA regule (932130)
# — i ktore nie nadazylo za rzeczywistoscia. Ponizej powod, pomiar i cena.
#
# HISTORIA. 2026-08-12: redaktor nie mogl zapisac rekordu, `POST
# /admin/bpp/wydawnictwo_ciagle/105013/change/` -> blokada, Total Score 5.
# Zapalala 932130 ("Unix Shell Expression Found"), bo transformacja `t:cmdLine`
# KASUJE SPACJE PRZED `(`, wiec legalne zdanie zmienia sie w wyrazenie powloki
# dopiero W SILNIKU:
#
#     wpisane:      wynik istotny (p < (0,05))
#     po cmdLine:   wynik istotny(p <(0 05))
#                                   ^^^^^^^ pasuje do `[<>]\(.*\)`
#
# Zdjelismy wtedy sama 932130, z zapisem w komentarzu: "gdy ktoras z pozostalych
# realnie strzeli — dopisac ja tutaj PO ZMIERZENIU". Strzelily. Trzy razy
# w jedenascie dni, za kazdym razem INNA regula.
#
# POMIAR 2026-08-23 (produkcja bpp.umlub.pl, audit log z Loki, okno 7 dni).
# Kluczowa obserwacja: `/admin/` dzieli sie na dwie rozlaczne populacje, a
# granica biegnie DOKLADNIE po liczbie segmentow sciezki.
#
# GLEBOKIE (`/admin/<app>/<model>/...`) — 160 blokad, 100% falszywych alarmow,
# CZTERY rozne reguly na DWOCH modelach:
#
#   932115 x60  Windows Command Injection    ARGS:streszczenia-0-streszczenie
#               Matched: "; type 1 diabetes mellitus; air pollution; particulate
#               matter; nitrogen dioxide; ..." -> `;` + `type` (komenda Windows)
#   933210 x50  PHP Variable Function Call    ARGS:streszczenia-0-streszczenie
#               Matched: "(PPEQ) (the Polish adaptation of the CAHPS Child
#               Hospital Survey (Child HCAHPS))" -> wzorzec `(...)(...)`
#   930110 x30  Path Traversal (/../)         ARGS:autorzy_set-7-data_oswiadczenia
#               Matched: ".." -> niedokonczona data z widgetu `dd.mm.rrrr`
#   942100 x20  SQLi via libinjection         /admin/bpp/wydawnictwo_zwarte/
#
# PLYTKIE (`/admin/login/`, `/admin/.env`) — 343 blokady, 100% realnych atakow:
#
#   942100 x129, 942190 x115, 920220 x66, 942140 x27, 942230 x1 -> /admin/login/
#   930130 x5                                                   -> /admin/.env
#
# DLACZEGO NIE DOPISUJEMY KOLEJNYCH ID. Wyzwalaczem nie jest zaden konkretny
# wzorzec, tylko SAMA NATURA DANYCH: anglojezyczne streszczenie naukowe to
# kilka tysiecy znakow wolnego tekstu, gestego od srednikow, nawiasow, akronimow
# i notacji statystycznej. CRS na PL1 skanuje to dziesiatkami regul skladniowych,
# z ktorych kazda ma severity CRITICAL = 5 pkt przy progu 5 — JEDNO trafienie
# blokuje, zapasu nie ma. Kolejne streszczenie znajdzie kolejna regule, a "type 1
# diabetes" nie da sie przewidziec z wyprzedzeniem. Wyliczanka ID przegrywa
# z ta gra i przegrala juz dwa razy. To ten sam argument, ktory uzasadnia 10006
# dla `/grafana/` (LogQL jest z natury gesty od metaznakow).
#
# CENA, WPROST: na `^/admin/<app>/<model>/` realny payload RCE, SQLi czy XSS
# NIE JEST JUZ BLOKOWANY. Nie udajemy, ze to za darmo — asercje w test-waf.sh
# zapisuja to jako oczekiwany PASS, zeby nikt nie odkryl tego przypadkiem.
#
# DLACZEGO TO AKCEPTOWALNE:
#   1. Kazdy z tych endpointow wymaga konta ze `staff_member_required`. Kto tam
#      POST-uje, jest juz uwierzytelnionym redaktorem.
#   2. Django parametryzuje SQL przez ORM, a szablony auto-escapuja HTML —
#      ochrona skladniowa CRS jest tu w duzej mierze zdublowaniem.
#   3. Jedyny anonimowo osiagalny endpoint admina to formularz logowania i on
#      zostaje CHRONIONY W PELNI. Pomiar wyzej pokazuje, ze to wlasnie tam leci
#      caly realny ruch atakujacy: 338 z 343 plytkich blokad.
#
# DLACZEGO DetectionOnly, A NIE Off: trafienia dalej ida do audit logu, wiec
# widac je na dashboardzie WAF-a jako `detected` (zmienna "Akcja"). Przy `Off`
# slad znika calkowicie i nie dowiemy sie, ze cos nowego zaczelo strzelac.
# Ta sama konwencja co 10002 i 10003.
#
# DLACZEGO `REQUEST_FILENAME`, A NIE `REQUEST_URI` — TO NIE JEST KOSMETYKA
# I TERAZ WAZY DUZO WIECEJ NIZ PRZY 932130. `REQUEST_URI` zawiera QUERY STRING,
# a wzorzec ma dwa zmienne segmenty, wiec query string potrafi go domknac na
# cudzej sciezce:
#
#     /admin/login/?next=/admin/
#             ^^^^^  ^^^^^^^^^^^   "?next=" jako [^/]+ i "/admin/" jako [^/]+/
#
# Przy poprzedniej wersji reguly kosztowaloby to zdjecie JEDNEJ reguly z
# formularza logowania. Teraz kosztowaloby ZDJECIE CALEGO CRS z jedynego
# anonimowo osiagalnego endpointu admina — czyli dokladnie z tego miejsca,
# w ktore leci 338 blokad na 7 dni. `REQUEST_FILENAME` to sama sciezka, wiec
# `/admin/login/`, `/admin/password_change/`, `/admin/logout/` i
# `/admin/jsi18n/` maja po `/admin/` tylko jeden segment i NIE pasuja. Pilnuja
# tego asercje kontrolne w test-waf.sh: obie postacie logowania (gola i z
# `?next=`) plus realne SQLi na `/admin/login/`.
#
# ZASIEG: `^/admin/<app>/<model>/` pokrywa jednym wzorcem komplet formularzy
# modelu — `<pk>/change/`, `add/`, changelist z akcjami masowymi, `<pk>/delete/`
# i `autocomplete/`. Wszystkie przyjmuja te same pola tekstowe.
#
# NIE MA POTRZEBY OSOBNEGO, GLOBALNEGO WYKLUCZENIA TYCH REGUL. Zmierzone
# 2026-08-23: 930110, 932115, 933210 i 932130 nie zapalily sie w oknie 7 dni
# ANI RAZU poza `/admin/`. Wypisanie ich obok tej reguly byloby martwym kodem.
# (942100 owszem strzela poza adminem — 273x na `/bpp/autorzy` — ale to inny
# problem, z wlasnym wyzwalaczem, i nie zalatwia go wykluczenie dla `/admin/`.)
#
# UWAGA: regula 10002 (`/admin/dbtemplates/`) zostaje nietknieta. Jest teraz dla
# swojego prefiksu nadmiarowa, ale obejmuje takze `/admin/dbtemplates/` bez
# drugiego segmentu, ktorego ta regula nie lapie.
SecRule REQUEST_FILENAME "@rx ^/admin/[^/]+/[^/]+/" \
    "id:10009,\
    phase:1,\
    pass,\
    nolog,\
    t:none,\
    ctl:ruleEngine=DetectionOnly"

# ---------------------------------------------------------------------------
# 10010: 953110 ("PHP source code leakage") — GLOBALNIE, bo w BPP nie ma PHP
# ---------------------------------------------------------------------------
# Regula 953110 skanuje CIALO ODPOWIEDZI wzorcem nazw funkcji PHP:
#
#   \b(?:f(?:tp_...|get(?:s?s|c)|scanf|write|open|read)|gz(?:...)|session_start
#     |scandir|read(?:(?:gz)?file|dir)|move_uploaded_file|(?:proc_|bz)open
#     |call_user_func)|\$_(?:(?:pos|ge)t|session)\b
#
# ZGLOSZENIE 2026-08-12 (bpp.umlub.pl): `GET /api/v1/zrodlo/` konczylo sie
# urwana odpowiedzia. Czasopismo "4open" (EDP Sciences, zrodlo id 4276) ma
# w bazie DOI `10.1051/fopen/`. Granice slowa we wzorcu SA, ale ukosniki to
# znaki NIESLOWNE — `fopen` jest w tym DOI pelnoprawnym tokenem i regula trafia.
#
# ODTWORZONE LOKALNIE na realnym ciele odpowiedzi z produkcji, na tym samym
# obrazie (owasp/modsecurity-crs:nginx), przez konfiguracje z defaults/webserver:
#
#   ruleId=953110 sev=3  PHP source code leakage
#      data: Matched Data: fopen found within RESPONSE_BODY: ...
#   ruleId=959100 sev=0  Outbound Anomaly Score Exceeded (Total Score: 4)
#
# Severity ERROR = 4 pkt przy progu WYJSCIOWYM 4 (ANOMALY_OUTBOUND), wiec
# pojedyncze trafienie od razu przekracza prog — reguly wychodzace nie maja
# zapasu, jaki maja wejsciowe.
#
# OBJAW JEST MYLACY, bo 959100 dziala w phase:4, gdy nagłowki sa juz u klienta:
#
#   Accept: application/json  -> 200, 5733 B, dziala      (JSON NIE jest skanowany)
#   Accept: text/html         -> 200 + Content-Length: 18014, dojechalo 15588 B
#   /api/v1/zrodlo/4276/      -> polaczenie zerwane, 0 B
#
# Serwer obiecuje 200 OK, wysyla czesc ciala i zrywa polaczenie. Klient widzi
# urwana strone albo blad transportu, nie blokade.
#
# DLACZEGO GLOBALNIE, A NIE NA `/api/` — TO NIE JEST PROBLEM SCIEZKI, TYLKO
# DANYCH. Wyzwalaczem jest WARTOSC W BAZIE (DOI zrodla), a nie adres. Ten sam
# ciag wyrenderuje sie wszedzie, gdzie pokazujemy to zrodlo lub publikacje
# z niego — listy, detale rekordow, raporty, eksporty HTML. Wykluczenie po
# prefiksie URI byloby gra w kreta: kazda nowa strona pokazujaca ten DOI
# psulaby sie od nowa, za kazdym razem z objawem nie wskazujacym na WAF.
#
# DLACZEGO WOLNO ZDJAC CALA REGULE: 953110 wykrywa WYCIEK KODU ZRODLOWEGO PHP.
# W BPP nie ma PHP — ani interpretera, ani plikow, ani modulu w nginksie. Stos
# to Django/Python. Reguła nie ma tu czego chronic, wiec jedyne, co moze
# wyprodukowac, to falszywe alarmy na danych bibliograficznych. Zadania o `*.php`
# sa dodatkowo odcinane 444 juz na brzegu (_bpp-locations.conf, patrz
# "Utwardzenie brzegu") — sonda o plik PHP nie dochodzi nawet do Django.
#
# ZAKRES: zdejmujemy JEDNA regule, nie cala rodzine 953 i nie wszystkie reguly
# wychodzace. Siostrzane zostaja i nadal chronia:
#   953100 (@pmFromFile php-errors.data) — komunikaty bledow PHP,
#   953120 (@rx `<\?(?!xml)`)            — znaczniki `<?php` w odpowiedzi.
# Zmierzone 2026-08-12: dzisiejszy php-errors.data ma 218 wpisow i wszystkie sa
# dlugimi frazami ("PDO: driver", "Cannot redeclare class", "Stack trace:"),
# wiec nie zapalaja sie na danych bibliograficznych. Gdy ktoras z nich realnie
# strzeli — dopisac ja tutaj PO ZMIERZENIU, jak wyzej.
#
# UWAGA: `SecAction`, a nie `SecRule`, bo wykluczenie jest bezwarunkowe. Musi
# byc w phase:1, zeby wykonac sie przed faza 4, w ktorej dziala 953110.
# `SecRuleRemoveById` tu NIE zadziala — nasz plik jest includowany przed CRS.
SecAction \
    "id:10010,\
    phase:1,\
    nolog,\
    pass,\
    t:none,\
    ctl:ruleRemoveById=953110"

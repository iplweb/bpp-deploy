logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ============================================================================
// Wykrywanie poziomu logu + parsowanie trafien WAF-a.
//
// UWAGA NA KOLEJNOSC: kolejne `stage.regex` NIE dzialaja jak "sprobuj po kolei,
// przerwij na pierwszym trafieniu". Kazdy trafiony etap NADPISUJE ten sam klucz,
// wiec wygrywa OSTATNI. Wczesniejsza wersja tego pliku byla ulozona od
// najbardziej do najmniej wiarygodnego detektora — czyli odwrotnie do tego, jak
// to dziala — przez co "last resort" (\berror\b gdziekolwiek w linii) przykrywal
// wszystko powyzej i nadawal detected_level=error linii access logu
// `GET /jakas-error-page`.
//
// Dlatego kazdy detektor pisze do WLASNEGO klucza (`lvl_*`), a wyboru dokonuje
// jedna bramka na koncu. Dodanie nowego detektora nie moze juz popsuc istniejacych.
// ============================================================================
loki.process "log_levels" {

  // ── Detektory poziomu ────────────────────────────────────────────────────
  // Kazdy zapisuje do wlasnego klucza; zaden nie moze nadpisac innego.

  // Logi strukturalne JSON (np. Dozzle).
  stage.json {
    expressions = { lvl_json = "level" }
  }

  // Format klucz-wartosc: level=INFO, level=ERROR
  stage.regex {
    expression = "level=(?P<lvl_kv>(?i:TRACE|DEBUG|INFO|WARN(?:ING)?|ERROR|FATAL|CRITICAL))\\b"
  }

  // Format loggera Pythona: INFO:modul:komunikat
  stage.regex {
    expression = "^(?P<lvl_py>(?i:DEBUG|INFO|WARNING|ERROR|CRITICAL)):"
  }

  // Format w nawiasach kwadratowych: [info], [ERROR] — m.in. nginx.
  stage.regex {
    expression = "\\[(?P<lvl_bracket>(?i:trace|debug|info|notice|warn(?:ing)?|error|crit(?:ical)?|alert|emerg(?:ency)?))\\]"
  }

  // Ostrzezenia Pythona: UserWarning, SecurityWarning, DeprecationWarning…
  stage.regex {
    expression = "(?P<lvl_pywarn>(?i:[A-Za-z]*Warning))\\b"
  }

  // Ostatnia deska ratunku: samodzielne slowo-poziom gdziekolwiek w linii.
  // NAJMNIEJ wiarygodne — bramka nizej siega po nie dopiero gdy nic innego
  // nie trafilo.
  //
  // `(?:^|[^\w/])` — slowo NIE moze byc poprzedzone ukosnikiem. Bez tego
  // warunku linia access logu `GET /raport/error-summary.html` dostawala
  // detected_level=error, bo `\berror\b` trafia w SRODEK sciezki URL (ukosnik
  // i myslnik to dla `\b` granice slowa). Zadna z wyzszych regul nie ma czym
  // takiej linii przykryc, wiec sama kolejnosc detektorow tego nie leczy.
  stage.regex {
    expression = "(?:^|[^\\w/])(?P<lvl_any>(?i:TRACE|DEBUG|INFO|WARN(?:ING)?|ERROR|FATAL|CRITICAL))\\b"
  }

  // ── ModSecurity: audit log (JSON) ────────────────────────────────────────
  //
  // Kazde oflagowane zadanie zostawia w stdout webservera DWA wpisy:
  //   1. linia tekstowa nginksowego error.log ("ModSecurity: Access denied…"),
  //   2. TEN wpis — pelny audit log w JSON.
  //
  // Cala tresc analityczna jest w (2). W (1) laduja WYLACZNIE reguly decyzyjne
  // (949110 inbound, 959100 outbound) — indywidualne reguly ataku (942xxx SQLi,
  // 941xxx XSS, 930xxx LFI) w CRS z anomaly scoring NIE logują się do error.log.
  // Sprawdzone empirycznie: 8 linii error.log vs 11 wpisow audit na tym samym
  // przebiegu `make test-waf`, i tylko wpisy audit znaja rodzaj ataku.
  //
  // `is_interrupted` rozdziela zablokowane od tylko wykrytych — sciezki wyjete
  // regulami 10002/10003 (ctl:ruleEngine=DetectionOnly) maja `false` + HTTP 200.
  //
  // Selektor po "is_interrupted": klucz wystepuje wylacznie w audit logu.
  // Marker "ModSecurity-nginx" NIE nadaje sie — jest tez w linii startowej
  // "[notice] ModSecurity-nginx v1.0.4 (rules loaded…)".
  //
  // Wymaga MODSEC_AUDIT_LOG_FORMAT=JSON (domyslne w obrazie CRS). Pola pochodza
  // z czesci A i H (MODSEC_AUDIT_LOG_PARTS=AHZ) — CELOWO bez czesci B, wiec
  // `request.headers` (a w nich Cookie z sessionid) tutaj nie ma. Nie dodawaj B.
  stage.match {
    selector = "{job=\"docker\"} |~ \"is_interrupted\""

    stage.json {
      expressions = {
        modsec_blocked   = "transaction.is_interrupted",
        modsec_client    = "transaction.client_ip",
        modsec_unique_id = "transaction.unique_id",
        modsec_hostname  = "transaction.request.hostname",
        modsec_method    = "transaction.request.method",
        modsec_uri       = "transaction.request.uri",
        modsec_code      = "transaction.response.http_code",
        // messages[0] to PIERWSZA dopasowana regula, czyli ta merytoryczna
        // (942100 SQLi, 941100 XSS…). Regula decyzyjna 949110 jest OSTATNIA
        // i ma severity 0 — brac jej za "te reguly" byloby bez wartosci.
        modsec_rule_id   = "transaction.messages[0].details.ruleId",
        modsec_msg       = "transaction.messages[0].message",
        modsec_severity  = "transaction.messages[0].details.severity",
        // Pelny lancuch regul, do wyszukiwania (`|~`), nie do grupowania.
        modsec_rules     = "join(',', transaction.messages[*].details.ruleId)",
        // Kategoria ataku z tagow CRS. `| [0]` bo ta sama kategoria powtarza
        // sie w kazdej dopasowanej regule (bez tego: "attack-sqli,attack-sqli").
        modsec_attack    = "transaction.messages[].details.tags[?starts_with(@, 'attack-')][] | [0]",
        modsec_paranoia  = "transaction.messages[].details.tags[?starts_with(@, 'paranoia-level/')][] | [0]",
        // Komunikat reguly progowej — zrodlo anomaly score i kierunku.
        // Po tresci, nie po ID: ta sama fraza obsluguje 949110 i 959100.
        modsec_scoremsg  = "transaction.messages[?contains(message, 'Anomaly Score Exceeded')].message | [0]",
      }
    }

    // Prefiksy tagow CRS sa szumem w legendzie wykresu: "attack-sqli" -> "sqli",
    // "paranoia-level/1" -> "1".
    //
    // KAZDY szablon ponizej musi miec straznika `{{ if … }}`. Odwolanie do
    // klucza, ktorego stage.json nie utworzyl, renderuje sie jako LITERAL
    // "<no value>" (nie pusty string), a stage.template ZAWSZE tworzy klucz
    // `source` — bez straznika trafienie bez tagu attack-* wpisaloby do
    // structured metadata dokladnie "<no value>".
    stage.template {
      source   = "modsec_attack"
      template = "{{ if .modsec_attack }}{{ regexReplaceAll \"^attack-\" .modsec_attack \"\" }}{{ end }}"
    }

    stage.template {
      source   = "modsec_paranoia"
      template = "{{ if .modsec_paranoia }}{{ regexReplaceAll \"^paranoia-level/\" .modsec_paranoia \"\" }}{{ end }}"
    }

    // "Inbound Anomaly Score Exceeded (Total Score: 10)" -> score 10, inbound.
    // Kierunek ma znaczenie operacyjne: trafienia OUTBOUND (RESPONSE-95x, faza 4)
    // to ta klasa, ktora potrafi uciac odpowiedz juz po wyslaniu naglowkow —
    // patrz regula 10004 w modsecurity-override.conf.template.
    stage.regex {
      source     = "modsec_scoremsg"
      expression = "Total Score: (?P<modsec_score>\\d+)"
    }

    stage.regex {
      source     = "modsec_scoremsg"
      expression = "^(?P<modsec_direction>Inbound|Outbound)"
    }

    stage.template {
      source   = "modsec_direction"
      template = "{{ if .modsec_direction }}{{ ToLower .modsec_direction }}{{ end }}"
    }

    stage.template {
      source   = "modsec_action"
      template = "{{ if eq .modsec_blocked \"true\" }}blocked{{ else if .modsec_blocked }}detected{{ end }}"
    }

    // Rozroznienie blizniakow — patrz komentarz przy bloku error.log nizej.
    // Panele agregujace MUSZA filtrowac `modsec_src="audit"`, inaczej licza
    // kazde zadanie dwa razy.
    stage.template {
      source   = "modsec_src"
      template = "audit"
    }

    // Structured metadata, NIE labele. `modsec_uri`, `modsec_client`
    // i `modsec_unique_id` jako stream labele wysadzilyby kardynalnosc indeksu
    // strumieni (kazda para IP x URI = nowy strumien na dysku). Structured
    // metadata filtruje sie i grupuje w LogQL bez parsera i bez tego kosztu.
    stage.structured_metadata {
      values = {
        modsec_action    = "",
        modsec_rule_id   = "",
        modsec_msg       = "",
        modsec_severity  = "",
        modsec_rules     = "",
        modsec_attack    = "",
        modsec_paranoia  = "",
        modsec_direction = "",
        modsec_score     = "",
        modsec_uri       = "",
        modsec_method    = "",
        modsec_client    = "",
        modsec_hostname  = "",
        modsec_code      = "",
        modsec_unique_id = "",
        modsec_src       = "",
      }
    }

    stage.template {
      source   = "lvl_modsec"
      template = "warn"
    }
  }

  // ── ModSecurity: linia error.log ─────────────────────────────────────────
  //
  // Blizniacza linia tekstowa do wpisu audit powyzej — i to WLASNIE NA NIA
  // patrzy czlowiek w dashboardzie "Log Monitoring", bo audit log to sciana
  // JSON-a. Dlatego dostaje wlasny komplet pol, mimo ze sa redundantne wobec
  // blizniaka: bez nich operator widzi komunikat, ktorego nie da sie odfiltrowac
  // inaczej niz pelnotekstowo.
  //
  // Czego tu NIE MA i miec nie moze: `modsec_attack` i `modsec_rules`. Do
  // error.log trafiaja wylacznie reguly decyzyjne (949110/959100), a ich tagi to
  // `anomaly-evaluation`, nie `attack-*`. Rodzaj ataku jest wylacznie w JSON-ie.
  //
  // `modsec_src` rozroznia blizniakow: `nginx` tutaj, `audit` wyzej. Panele
  // agregujace filtruja `modsec_src="audit"`, zeby nie liczyc kazdego zadania
  // dwa razy.
  //
  // `warn`, a nie `error`, mimo ze nginx loguje ja jako [error]. Ta sama decyzja
  // co przy `limit_req_log_level warn` w _bpp-locations.conf: powodz zdarzen
  // bezpieczenstwa nie ma zalewac dashboardu bledow APLIKACJI. Skan z lipca 2026
  // to bylo 2165 zadan z 1342 adresow IP — kazde trafienie to osobna linia
  // [error], czyli tysiace "bledow" przy w pelni sprawnej aplikacji.
  // Trafienia WAF-a maja wlasny dashboard (grafana/dashboards/waf.json).
  stage.match {
    selector = "{job=\"docker\"} |~ \"ModSecurity: (Access denied|Warning|Access allowed)\""

    // Same `stage.regex` — one tworza klucz TYLKO gdy trafia, wiec nie grozi im
    // literal "<no value>", ktory wchodzi przez `stage.template`.
    stage.regex {
      expression = "ModSecurity: (?P<modsec_verdict>Access denied|Warning|Access allowed)"
    }

    stage.regex {
      expression = "\\[id \"(?P<modsec_rule_id>[^\"]*)\"\\]"
    }

    stage.regex {
      expression = "\\[msg \"(?P<modsec_msg>[^\"]*)\"\\]"
    }

    stage.regex {
      expression = "\\[severity \"(?P<modsec_severity>[^\"]*)\"\\]"
    }

    stage.regex {
      expression = "\\[uri \"(?P<modsec_uri>[^\"]*)\"\\]"
    }

    stage.regex {
      expression = "\\[hostname \"(?P<modsec_hostname>[^\"]*)\"\\]"
    }

    stage.regex {
      expression = "\\[unique_id \"(?P<modsec_unique_id>[^\"]*)\"\\]"
    }

    stage.regex {
      expression = "\\[client (?P<modsec_client>[^\\]]*)\\]"
    }

    stage.regex {
      expression = "Total Score: (?P<modsec_score>\\d+)"
    }

    stage.regex {
      expression = "\\[msg \"(?P<modsec_direction>Inbound|Outbound)"
    }

    stage.template {
      source   = "modsec_direction"
      template = "{{ if .modsec_direction }}{{ ToLower .modsec_direction }}{{ end }}"
    }

    // "Access denied" = polaczenie zerwane; "Warning" = tylko zalogowane
    // (sciezki w DetectionOnly). Ta sama para wartosci co `is_interrupted`
    // w blizniaku JSON, zeby dalo sie filtrowac jednym wyrazeniem.
    stage.template {
      source   = "modsec_action"
      template = "{{ if eq .modsec_verdict \"Access denied\" }}blocked{{ else if .modsec_verdict }}detected{{ end }}"
    }

    stage.template {
      source   = "modsec_src"
      template = "nginx"
    }

    stage.structured_metadata {
      values = {
        modsec_action    = "",
        modsec_rule_id   = "",
        modsec_msg       = "",
        modsec_severity  = "",
        modsec_direction = "",
        modsec_score     = "",
        modsec_uri       = "",
        modsec_client    = "",
        modsec_hostname  = "",
        modsec_unique_id = "",
        modsec_src       = "",
      }
    }

    stage.template {
      source   = "lvl_modsec"
      template = "warn"
    }
  }

  // ── Bramka: wybor + normalizacja do zamknietego slownika ─────────────────
  //
  // Bierze PIERWSZY niepusty klucz w kolejnosci wiarygodnosci i mapuje go na
  // jedna z siedmiu dozwolonych wartosci. Wszystko inne -> `unknown`.
  //
  // Slownik jest ZAMKNIETY z rozmyslem: wczesniej `SecurityWarning` przeciekal
  // na label jako `securitywarning`, bo normalizacja byla lancuchem lat, a nie
  // brama. Tutaj wartosc spoza slownika nie ma jak sie przedostac.
  //
  // Slownik pokrywa sie z tym, ktorego uzywa wbudowana detekcja Loki
  // (`discover_log_levels`) — my ja wylaczamy flaga w docker-compose.monitoring.yml,
  // zeby zrodlo bylo JEDNO, ale zgodnosc slownika zostawia furtke powrotu
  // i pasuje do kolorowania poziomow w Grafanie.
  stage.template {
    source = "extracted_level"
    template = `{{- $l := "" -}}
{{- if .lvl_modsec }}{{ $l = .lvl_modsec }}
{{- else if .lvl_json }}{{ $l = .lvl_json }}
{{- else if .lvl_kv }}{{ $l = .lvl_kv }}
{{- else if .lvl_py }}{{ $l = .lvl_py }}
{{- else if .lvl_bracket }}{{ $l = .lvl_bracket }}
{{- else if .lvl_pywarn }}{{ $l = .lvl_pywarn }}
{{- else if .lvl_any }}{{ $l = .lvl_any }}
{{- end -}}
{{- $l = ToLower $l -}}
{{- $l = regexReplaceAll "^.*warning$" $l "warn" -}}
{{- if eq $l "critical" }}critical
{{- else if eq $l "crit" }}critical
{{- else if eq $l "fatal" }}critical
{{- else if eq $l "alert" }}critical
{{- else if eq $l "emerg" }}critical
{{- else if eq $l "emergency" }}critical
{{- else if eq $l "error" }}error
{{- else if eq $l "err" }}error
{{- else if eq $l "warn" }}warn
{{- else if eq $l "notice" }}info
{{- else if eq $l "info" }}info
{{- else if eq $l "debug" }}debug
{{- else if eq $l "trace" }}trace
{{- else }}unknown
{{- end -}}`
  }

  stage.labels {
    values = {
      detected_level = "extracted_level",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.local.targets
  labels        = { job = "docker" }
  relabel_rules = discovery.relabel.docker_labels.rules
  forward_to    = [loki.process.log_levels.receiver]
}

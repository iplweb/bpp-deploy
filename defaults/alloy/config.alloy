logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Log processing pipeline for level extraction
loki.process "log_levels" {
  // Try JSON structured logs first (e.g., Dozzle)
  stage.json {
    expressions = { extracted_level = "level" }
  }

  // Try key-value format: level=INFO, level=ERROR
  stage.regex {
    expression = "level=(?P<extracted_level>(?i:TRACE|DEBUG|INFO|WARN(?:ING)?|ERROR|FATAL|CRITICAL))\\b"
  }

  // Try Python logging format: INFO:module:message
  stage.regex {
    expression = "^(?P<extracted_level>(?i:DEBUG|INFO|WARNING|ERROR|CRITICAL)):"
  }

  // Try bracketed format: [info], [ERROR]
  stage.regex {
    expression = "\\[(?P<extracted_level>(?i:trace|debug|info|warn(?:ing)?|error|fatal|critical))\\]"
  }

  // Catch Python warnings: UserWarning, SecurityWarning, etc.
  stage.regex {
    expression = "(?P<extracted_level>(?i:UserWarning|SecurityWarning|DeprecationWarning|RuntimeWarning))"
  }

  // Last resort: standalone level words anywhere in log
  stage.regex {
    expression = "\\b(?P<extracted_level>(?i:TRACE|DEBUG|INFO|WARN(?:ING)?|ERROR|FATAL|CRITICAL))\\b"
  }

  // Normalize WARN → warning
  stage.replace {
    expression = "(?i)^warn$"
    replace    = "warning"
    source     = "extracted_level"
  }

  // Normalize FATAL → error
  stage.replace {
    expression = "(?i)^fatal$"
    replace    = "error"
    source     = "extracted_level"
  }

  // Normalize Python warnings → warning
  stage.replace {
    expression = "(?i)^.*Warning$"
    replace    = "warning"
    source     = "extracted_level"
  }

  // Convert to lowercase for consistency
  stage.template {
    source   = "extracted_level"
    template = "{{ .Value | ToLower }}"
  }

  // ModSecurity / OWASP CRS (audit log WAF-a).
  //
  // Musi byc PO ogolnych regulach wyzej, bo je nadpisuje. Audit log ModSecurity
  // to JSON BEZ pola `level`, wiec zadna z powyzszych regul nie trafia i konczy
  // sie na detected_level=unknown. Poziom bierzemy z `severity` reguly CRS,
  // ktora jest w skali sysloga:
  //   0 EMERGENCY  1 ALERT  2 CRITICAL  3 ERROR
  //   4 WARNING    5 NOTICE 6 INFO      7 DEBUG
  //
  // Transakcja bez dopasowanej reguly (przy MODSEC_AUDIT_ENGINE=On) nie ma
  // sekcji `messages` — wtedy severity jest puste i ustawiamy `info`.
  stage.match {
    selector = "{job=\"docker\"} |~ \"ModSecurity-nginx\""

    stage.json {
      expressions = {
        modsec_severity = "transaction.messages[0].details.severity",
      }
    }

    stage.template {
      source = "extracted_level"
      template = "{{ if eq .modsec_severity \"0\" }}critical{{ else if eq .modsec_severity \"1\" }}critical{{ else if eq .modsec_severity \"2\" }}critical{{ else if eq .modsec_severity \"3\" }}error{{ else if eq .modsec_severity \"4\" }}warning{{ else if eq .modsec_severity \"5\" }}info{{ else if eq .modsec_severity \"6\" }}info{{ else if eq .modsec_severity \"7\" }}debug{{ else }}info{{ end }}"
    }
  }

  // Add as label if extracted
  stage.labels {
    values = {
      detected_level = "extracted_level",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.local.targets
  labels        = { job = "docker" }
  relabel_rules = discovery.relabel.docker_labels.rules
  forward_to    = [loki.process.log_levels.receiver]
}
